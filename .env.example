# CREER VOTRE BASE DE DONNEES POSTGRESQL , ENSUITE REMPLACER DANS CE URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:PORT/DATABASE_NAME?sslmode=disable"
# Connexion directe (ex. Supabase port 5432) — utilisée par Prisma migrate/generate
DIRECT_URL="postgresql://USER:PASSWORD@localhost:PORT/DATABASE_NAME?sslmode=disable"

# URL publique du site (SEO / Open Graph). Sur Vercel, mets ton domaine de prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — en local: http://localhost:3000 | en prod: même URL que NEXT_PUBLIC_SITE_URL
AUTH_URL="http://localhost:3000"
# Clé secrète aléatoire pour l'authentification Auth.js (À générer via: npx auth secret)
AUTH_SECRET="mettez_ici_une_cle_secrete_aleatoire"
# Sur Vercel, recommandé :
# AUTH_TRUST_HOST="true"